<UserControl x:Class="LightSync.Controls.LabeledSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <StackPanel Margin="0,0,0,12">
        <DockPanel Margin="0,0,0,2">
            <TextBlock DockPanel.Dock="Right" Text="{Binding DisplayValue, ElementName=Root}"
                       Foreground="{StaticResource TextSecondary}" />
            <TextBlock Text="{Binding Label, ElementName=Root}" Foreground="{StaticResource TextPrimary}" />
        </DockPanel>
        <Slider x:Name="PART_Slider" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                Value="{Binding Value, ElementName=Root, Mode=TwoWay}" />
    </StackPanel>
</UserControl>
